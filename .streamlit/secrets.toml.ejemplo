# Copia este archivo como "secrets.toml" (en esta misma carpeta) y pega tus datos.
# secrets.toml NUNCA se sube a GitHub (está en .gitignore).
# En Streamlit Community Cloud estos mismos valores se pegan en: App settings -> Secrets.

AZURE_PREDICTION_URL = "https://...cognitiveservices.azure.com/customvision/v3.0/Prediction/.../classify/iterations/lsc-senas-v1/image"
AZURE_PREDICTION_KEY = "PEGA_AQUI_TU_CLAVE"

# OPCIONAL: contraseña de acceso a la app. Si se deja vacía (o se borra la línea), la app no pide contraseña.
# Sirve para que personas desconocidas no consuman predicciones de Azure (el recurso es de pago).
APP_PASSWORD = ""
